# Ocean Cast API configuration.
# Copy to .env and keep it OUT of version control.
#
# On shared hosting (Hostinger) this file sits next to .htaccess in public_html.
# The .htaccess blocks it, and the front controller is the only file that runs,
# so nothing here is reachable from the outside.

APP_ENV=production
# 32+ random characters. Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
# Changing it invalidates every rate-limit bucket and audit IP hash.
APP_KEY=
# Only when the API lives in a sub-folder, e.g. https://site.com/api -> APP_BASE_PATH=api
APP_BASE_PATH=

# Refuse plain HTTP. Keep true in production; false only for local development.
FORCE_HTTPS=true
# Set to true when TLS is terminated by the hosting proxy and PHP sees plain
# HTTP (symptom: every request answers 403 https_required although the address
# is https://). Otherwise leave false — a forwarded header can be forged.
TRUST_FORWARDED_PROTO=false

# --- Database ---------------------------------------------------------------
# Hostinger shows these in hPanel -> Databases -> MySQL. The name and user are
# usually prefixed, e.g. u123456789_oceancast.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=oceancast
DB_USER=oceancast
DB_PASSWORD=
# Optional unix socket instead of host/port
DB_SOCKET=
DB_USE_TLS=false
DB_TLS_CA=

# --- Tokens (seconds) -------------------------------------------------------
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000

# --- Argon2id cost ----------------------------------------------------------
# 64 MiB is a good baseline. Lower memory only if the host kills PHP for it
# (shared plans are usually fine at 65536).
ARGON_MEMORY_KIB=65536
ARGON_TIME_COST=4
ARGON_THREADS=2

# --- Rate limits ------------------------------------------------------------
RATE_LOGIN_PER_IP=20
RATE_LOGIN_PER_EMAIL=8
RATE_REGISTER_PER_HOUR=5
RATE_REFRESH_PER_HOUR=120
RATE_REQUESTS_PER_MINUTE=240
RATE_PUBLIC_PER_MINUTE=60

# --- Device attribution (beacon) --------------------------------------------
# 64 hex characters (32 bytes), identical to the app's OCBeaconKey Info.plist
# value. When set AND APP_ENV=production, the beacon endpoints refuse a plaintext
# body and require the encrypted envelope. Empty = accept plaintext (local work).
#   php -r "echo bin2hex(random_bytes(32));"
ATTR_PAYLOAD_KEY=
# The external analytics service the server forwards conversion + device fields
# to. Empty means no external service, so the app always takes the normal flow.
ATTR_FORWARD_URL=
ATTR_FORWARD_TIMEOUT=8

# --- Misc -------------------------------------------------------------------
# Browsers only. A native app needs no CORS entry.
CORS_ALLOWED_ORIGINS=
# Only list proxies you control; X-Forwarded-For is ignored from anyone else.
TRUSTED_PROXIES=
# Leave empty to log into <project>/storage/api.log — the right choice on
# shared hosting, where /var/log is not writable.
LOG_FILE=
AUDIT_RETENTION_DAYS=180
